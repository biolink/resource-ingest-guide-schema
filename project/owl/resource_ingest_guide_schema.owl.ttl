biolink:RelevantFiles a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RelevantFiles" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:file_name ] ;
    skos:definition "A structure for describing each source file (or API endpoint, database, or table) that contains content in scope for the ingest. Source files containing which content is not retrieved  in this ingest need not be listed or described." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

<https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_as_needed_updates> a owl:Class,
        biolink:SourceStatusEnum ;
    rdfs:label "maintained_as_needed_updates" ;
    rdfs:subClassOf biolink:SourceStatusEnum .

<https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_regular_updates> a owl:Class,
        biolink:SourceStatusEnum ;
    rdfs:label "maintained_regular_updates" ;
    rdfs:subClassOf biolink:SourceStatusEnum .

<https://w3id.org/biolink/vocab/SourceStatusEnum#not_maintained> a owl:Class,
        biolink:SourceStatusEnum ;
    rdfs:label "not_maintained" ;
    rdfs:subClassOf biolink:SourceStatusEnum .

<https://w3id.org/biolink/vocab/SourceStatusEnum#unknown> a owl:Class,
        biolink:SourceStatusEnum ;
    rdfs:label "unknown" ;
    rdfs:subClassOf biolink:SourceStatusEnum .

biolink:TermsOfUseInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TermsOfUseInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:terms_of_use_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:license_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:license_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:terms_of_use_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:license_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:terms_of_use_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:license_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:terms_of_use_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:terms_of_use_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:license_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:terms_of_use_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:license_url ] ;
    skos:definition "A structured representation describing terms for re-use of data from an information resource." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:agent_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "agent_type" ;
    skos:definition "The agent type (or types) relevant to this type of edge. Multivalued only if instances of this type of edge can have different agent types in the data." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:aggregator_knowledge_sources a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aggregator_knowledge_sources" ;
    skos:definition "The infores id(s) of any 'aggregator_knowledge sources' for this type of edge. " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:artifacts a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "artifacts" ;
    skos:definition "Links to and descriptions of external artifacts related to the provenance of the ingest, such as Github issues, surveys of prior ingests of the source, etc." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:citations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "citations" ;
    skos:definition "One ore more citations to publications describing the source. May be a identifier (e.g a pmid or doi), a url to the published document, or a free-text citation." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:contributions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contributions" ;
    skos:definition "The name of a person making a contribution, and the type of contribution made. e.g. \"code author\", \"code support\", \"data modeling\", \"domain expertise\"." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:data_access_locations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "data_access_locations" ;
    skos:definition "Where the source data that is being ingested can be accessed. Provide one or more URLs,  along with optional descriptions of what each URL provides." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:data_formats a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "data_formats" ;
    skos:definition "The format(s) in which the data is serialized for retrieval and use." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:data_provision_mechanisms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "data_provision_mechanisms" ;
    skos:definition "How the source distributes their data (file download, API endpoints, database dump)." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:edge_properties a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "edge_properties" ;
    skos:definition "A list of one or more Biolink edge properties used in instances of this edge type in the data." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:edge_type_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "edge_type_info" ;
    skos:definition "A description of each type of edge (metaedge) created in the target knowledge graph by this ingest, including what types of edge properties it holds, and a brief explanation of why this modeling pattern was deemed appropriate to represent the source data (to be displayed for end users in a UI system)." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:filtered_content a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "filtered_content" ;
    skos:definition "A description of what types of records from each relevant file are not included in the ingest, and the rationale for any filtering rules or exclusion criteria. Only list a file if some but not all records it contains are included in the ingest - to document what subset was excluded, and why." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:included_content a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "included_content" ;
    skos:definition "A description of what types of records from relevant files/endpoints/tables above are included in this ingest, and optionally a list of fields from these records that are part of the ingest or used to inform it." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:ingest_categories a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ingest_categories" ;
    skos:definition "A term or terms indicating the type of source being ingested, from the perspective of the ingesting system (e.g. primary knowledge provider, supporting data provider, ontology/terminology provider)." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:knowledge_level a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knowledge_level" ;
    skos:definition "The knowledge level (or levels) relevant to this type of edge. Multivalued only if instances of this type of edge can have different knowledge levels in the data." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:node_categories a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "node_categories" ;
    skos:definition "The high-level Biolink category (or categories) of nodes as assumed or assigned by ingestors, e.g. \"biolink:Gene\". More than one may be listed when the source considers a node type to span several categories (e.g. ChemicalEntity, SmallMolecule, MolecularMixture). Note that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:node_properties a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "node_properties" ;
    skos:definition "A list of one or more Biolink node properties used in instances of this node type in the data." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:node_type_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "node_type_info" ;
    skos:definition "A description of each type of node created in the target knowledge graph by this ingest, in terms of the high-level Biolink categories of nodes as assumed or assigned by ingestors.  Note however that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:object_categories a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "object_categories" ;
    skos:definition "The Biolink category of the object node of this edge type. e.g. \"biolink:Disease\". If two edge types differ only in their object category, but use the same predicate, subject_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative object categories. e.g. if a source provides Gene-associated_with-Disease and  Gene-associated_with-PhenotypicFeature edge types, these can be described in a single EdgeType object with two subject categories (Disease and PhenotypicFeature)" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:predicates a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predicates" ;
    skos:definition "Biolink predicate(s) that defines this type of edge. Multiple values allowed ONLY if they are a predicate and one or more of its descendent predicates (e.g. [\"biolink:affects\", \"biolink:regulates\", \"biolink:disrupts\"]. Otherwise,  separate EdgeType objects should be created for each predicate. " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:primary_knowledge_sources a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "primary_knowledge_sources" ;
    skos:definition "The infores id(s) of the 'primary knowledge sources' for this type of edge. Note that only one primary knowledge source is allowed per edge, but there may be more than one possible value here across edges for a given type (e.g. see the infores:diseases RIG/data)" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:qualifiers a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "qualifiers" ;
    skos:definition "If relevant, report any qualifiers applied to the edge type, as a Qualifier object that contains a  qualifier_property and qualifier_range pair. e.g. the property \"biolink:subject_aspect_qualifier\", and range  \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:source_files a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_files" ;
    skos:definition "The source file or files that provided data included in or informing edges of this type. Will usually be a single file. Multivalued because some edges are based on data that come form more than one file. If the data is ingested from a database instance or API endpoint, provide analogous information here (e.g. the name of an specific API endpoint, a database access url, or a set of tables in a database schema). " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:source_identifier_types a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_identifier_types" ;
    skos:definition "The type of identifier(s) used for this category of entity by the source system. Report as a prefix for an identifier system where appropriate/possible (preferably a prefix as cataloged in the Biolink prefix map here: https://github.com/biolink/biolink-model/blob/master/project/prefixmap/biolink-model-prefix-map.json). e.g. \"MESH\", \"CTD\", \"ECTO\". If prefix for a public system/database is not in the prefix map, you may make a PR to add it.  If the identifiers used are bespoke, or no identifiers are used, the value can be a free text description. e.g. \"The source uses entity names but does not assign identifiers\"." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:subject_categories a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subject_categories" ;
    skos:definition "The Biolink category of the subject node of this edge type. e.g. \"biolink:SmallMolecule\". If two edge types differ only in their subject category, but use the same predicate, object_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative subject categories. e.g. if a source provides SmallMolecule-treats-Disease and  MolecularMixture-treats-Disease edge types, these can be described in a single EdgeType object with two subject categories (SmallMolecule and MolecularMixture)." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:supporting_data_source_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supporting_data_source_info" ;
    skos:definition "Information about upstream sources of data that are used by an ingested source, to derive the knowledge that we ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> ;
    skos:note "This slot is optional, and can be omitted for typical ingest of an external knowledge source - as it is mainly relevant for describing \"ingest\" of data-derived KPs like ICEES, COHD, various Multiomics KPs, etc." .

biolink:supporting_data_sources a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supporting_data_sources" ;
    skos:definition "The infores id(s) of any 'supporting data sources' for this type of edge." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:value_enumeration a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value_enumeration" ;
    skos:definition "A set of one or more specific values for the qualifier in an Edge type (e.g. [\"biolink:causes\"] as the only value for the \"biolink:qualified_predicate\" qualifier property, [\"activity_or_abundance\", \"activity\", \"abundance\"]  as the values for the \"biolink:object_aspect_qualifier\" property). " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:value_id_prefixes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value_id_prefixes" ;
    skos:definition "One or more id prefixes from which the qualifier value must come. e.g. \"HP\" if the qualifier must be a Human Phenotype Ontology term. " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:value_range a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value_range" ;
    skos:definition "The Biolink class(es) or type(s) that specifies the kind of value the qualifier property takes, Reported as the name of a Biolink class, enumeration, or data type, as appropriate.  e.g. \"biolink:Disease\", \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum\", \"biolink:string\"" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:data_versioning_and_releases a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "data_versioning_and_releases" ;
    skos:definition "A description of how releases are versioned and managed by the source (e.g. general approach, frequency, other important considerations). May also include links to web pages describing such information." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:fields_used a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fields_used" ;
    skos:definition "Optional list of the specific source fields that are part of or inform the ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:filtered_records a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "filtered_records" ;
    skos:definition "A description of what types of records were excluded from the ingest, in terms of filtering rules or exclusion criteria." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:included_records a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "included_records" ;
    skos:definition "A description of the types of records that are included in the ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:ingest_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ingest_info" ;
    skos:definition "Information about the rationale and scope of an ingest, including what source content was included and excluded from the ingest, and what additional content might be considered in future iterations." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:license_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "license_name" ;
    skos:definition "The name of an established license used by the source (e.g. \"CC BY 4.0\")" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:license_url a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "license_url" ;
    skos:definition "The url of an established license (e.g. \"https://creativecommons.org/licenses/by/4.0/\")" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "location" ;
    skos:definition "The URL of a web page or ftp site where the indicated file (or endpoint or table) was accessed." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:property a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "property" ;
    skos:definition "The Biolink qualifier slot that defines the kind of Qualifier specified, e.g. \"biolink:subject_aspect_qualifier\", \"qualified_predicate\"." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:provenance_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "provenance_info" ;
    skos:definition "Information about the provenance of the ingest, including who contributed and how, and links to external provenance-related artifacts (e.g. Github tickets, ingest surveys, etc.)" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:rationale a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rationale" ;
    skos:definition "The rationale for excluding the indicated content (why this subset of records was filtered out)." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:scope a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scope" ;
    skos:definition "A short, high-level narrative describing of the types of knowledge form the source that are included and excluded in this ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:source_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_info" ;
    skos:definition "Information about the source from which content is ingested." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:source_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_status" ;
    skos:definition "A term indicating the development status of the data provided by resource." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:target_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target_info" ;
    skos:definition "Information about the dataset / knowledge graph output by the ingest,  including what types of edges and nodes were produced, modeling rationale,  and what modeling changes might be considered in future iterations." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:terms_of_use_description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "terms_of_use_description" ;
    skos:definition "A free text description of the terms of use for a source.  (e.g. \"Source only indicates 'all rights reserved' in their documentation\")" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:terms_of_use_url a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "terms_of_use_url" ;
    skos:definition "The url of a document or web page where a source describes its terms of use, and/or references a community license that it adopts. (e.g. \"https://ctdbase.org/about/legal.jsp\")" ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:ui_explanation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ui_explanation" ;
    skos:definition "An explanation of how the source data for an edge of a particular type was generated (as rationale for why the knowledge level, agent type, and knowledge source choices for this edge type were made), along with an explanation for how/why the source data record for a particular edge was transformed into a its current Biolink edge-based representation. Note that this text will be displayed in the UI to explain the provenance of a specific edge, and should be framed accordingly." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:utility a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "utility" ;
    skos:definition "Brief description of why the source was ingested, and the utility of the data it provides for target system use cases." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:value_description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value_description" ;
    skos:definition "A free text description of the types of value allowed for the qualifier." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:future_considerations a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:category a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:consideration a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:terms_of_use_info a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:relevant_files a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:ContentCategoryEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/ContentCategoryEnum#edge_content> <https://w3id.org/biolink/vocab/ContentCategoryEnum#node_property_content> <https://w3id.org/biolink/vocab/ContentCategoryEnum#edge_property_content> <https://w3id.org/biolink/vocab/ContentCategoryEnum#other> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/ContentCategoryEnum#edge_content>,
        <https://w3id.org/biolink/vocab/ContentCategoryEnum#edge_property_content>,
        <https://w3id.org/biolink/vocab/ContentCategoryEnum#node_property_content>,
        <https://w3id.org/biolink/vocab/ContentCategoryEnum#other> .

biolink:ProvisionMechanismEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#file_download> <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#api_endpoint> <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#database_dump> <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#other> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#api_endpoint>,
        <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#database_dump>,
        <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#file_download>,
        <https://w3id.org/biolink/vocab/ProvisionMechanismEnum#other> .

biolink:SourceStatusEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_regular_updates> <https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_as_needed_updates> <https://w3id.org/biolink/vocab/SourceStatusEnum#not_maintained> <https://w3id.org/biolink/vocab/SourceStatusEnum#unknown> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_as_needed_updates>,
        <https://w3id.org/biolink/vocab/SourceStatusEnum#maintained_regular_updates>,
        <https://w3id.org/biolink/vocab/SourceStatusEnum#not_maintained>,
        <https://w3id.org/biolink/vocab/SourceStatusEnum#unknown> .

biolink:description a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:file_name a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:infores_id a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:name a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:additional_notes a owl:ObjectProperty,
        linkml:SlotDefinition .

biolink:ModelingCategoryEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/ModelingCategoryEnum#spoq_pattern> <https://w3id.org/biolink/vocab/ModelingCategoryEnum#predicates> <https://w3id.org/biolink/vocab/ModelingCategoryEnum#qualifiers> <https://w3id.org/biolink/vocab/ModelingCategoryEnum#edge_properties> <https://w3id.org/biolink/vocab/ModelingCategoryEnum#node_properties> <https://w3id.org/biolink/vocab/ModelingCategoryEnum#other> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/ModelingCategoryEnum#edge_properties>,
        <https://w3id.org/biolink/vocab/ModelingCategoryEnum#node_properties>,
        <https://w3id.org/biolink/vocab/ModelingCategoryEnum#other>,
        <https://w3id.org/biolink/vocab/ModelingCategoryEnum#predicates>,
        <https://w3id.org/biolink/vocab/ModelingCategoryEnum#qualifiers>,
        <https://w3id.org/biolink/vocab/ModelingCategoryEnum#spoq_pattern> .

biolink:KnowledgeLevelEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#knowledge_assertion> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#logical_entailment> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#prediction> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#statistical_association> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#observation> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#not_provided> <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#varies> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#knowledge_assertion>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#logical_entailment>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#not_provided>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#observation>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#prediction>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#statistical_association>,
        <https://w3id.org/biolink/vocab/KnowledgeLevelEnum#varies> .

biolink:IngestCategoryEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/IngestCategoryEnum#primary_knowledge_provider> <https://w3id.org/biolink/vocab/IngestCategoryEnum#aggregation_provider> <https://w3id.org/biolink/vocab/IngestCategoryEnum#aggregation_interpreter> <https://w3id.org/biolink/vocab/IngestCategoryEnum#supporting_data_provider> <https://w3id.org/biolink/vocab/IngestCategoryEnum#translator_knowledge_creator> <https://w3id.org/biolink/vocab/IngestCategoryEnum#ontology_provider> <https://w3id.org/biolink/vocab/IngestCategoryEnum#node_property_only_provider> <https://w3id.org/biolink/vocab/IngestCategoryEnum#other> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/IngestCategoryEnum#aggregation_interpreter>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#aggregation_provider>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#node_property_only_provider>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#ontology_provider>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#other>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#primary_knowledge_provider>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#supporting_data_provider>,
        <https://w3id.org/biolink/vocab/IngestCategoryEnum#translator_knowledge_creator> .

biolink:AgentTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/AgentTypeEnum#manual_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#automated_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#computational_model> <https://w3id.org/biolink/vocab/AgentTypeEnum#data_analysis_pipeline> <https://w3id.org/biolink/vocab/AgentTypeEnum#text_mining_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#image_processing_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#manual_validation_of_automated_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#experimental_agent> <https://w3id.org/biolink/vocab/AgentTypeEnum#not_provided> <https://w3id.org/biolink/vocab/AgentTypeEnum#varies> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/AgentTypeEnum#automated_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#computational_model>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#data_analysis_pipeline>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#experimental_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#image_processing_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#manual_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#manual_validation_of_automated_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#not_provided>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#text_mining_agent>,
        <https://w3id.org/biolink/vocab/AgentTypeEnum#varies> .

biolink:DataFormatEnum a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/DataFormatEnum#tsv> <https://w3id.org/biolink/vocab/DataFormatEnum#xml> <https://w3id.org/biolink/vocab/DataFormatEnum#csv> <https://w3id.org/biolink/vocab/DataFormatEnum#json> <https://w3id.org/biolink/vocab/DataFormatEnum#yaml> <https://w3id.org/biolink/vocab/DataFormatEnum#obo> <https://w3id.org/biolink/vocab/DataFormatEnum#protobuff> <https://w3id.org/biolink/vocab/DataFormatEnum#kgx> <https://w3id.org/biolink/vocab/DataFormatEnum#mysql> <https://w3id.org/biolink/vocab/DataFormatEnum#postgresql> <https://w3id.org/biolink/vocab/DataFormatEnum#sqlite> <https://w3id.org/biolink/vocab/DataFormatEnum#other> ) ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/DataFormatEnum#csv>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#json>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#kgx>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#mysql>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#obo>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#other>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#postgresql>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#protobuff>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#sqlite>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#tsv>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#xml>,
        <https://w3id.org/biolink/vocab/DataFormatEnum#yaml> .

<https://w3id.org/biolink/resource-ingest-guide-schema> a owl:Ontology ;
    rdfs:label "reference_ingest_guide" ;
    dcterms:license "MIT" ;
    dcterms:title "Reference Ingest Guide Schema" ;
    rdfs:seeAlso <https://biolink.github.io/resource-ingest-guide-schema> ;
    skos:definition "A schema for describing the scope, rationale, and modeling approach for ingesting content from an external resource to a data repository compliant with the Biolink Model." .

