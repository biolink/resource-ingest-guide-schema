      "name": "targetInformation__node_type_info",
      "description": "A description of each type of node created in the target knowledge graph by this ingest, in terms of the high-level Biolink categories of nodes as assumed or assigned by ingestors.  Note however that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/node_type_info",
      "alias": "node_type_info",
      "owner": "TargetInformation",
      "domain_of": [
        "TargetInformation"
      ],
      "range": "NodeType",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "targetInformation__future_considerations",
      "description": "Notes about mapping/modeling changes to consider in future iterations of this ingest.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/future_considerations",
      "alias": "future_considerations",
      "owner": "TargetInformation",
      "domain_of": [
        "TargetInformation"
      ],
      "range": "FutureModelingConsiderations",
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "targetInformation__additional_notes",
      "description": "Additional notes, considerations or resources relevant to mapping or modeling source data to the target model, that were not otherwise captured in dedicated attributes.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/additional_notes",
      "alias": "additional_notes",
      "owner": "TargetInformation",
      "domain_of": [
        "TargetInformation"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__subject_categories",
      "description": "The Biolink category of the subject node of this edge type. e.g. \"biolink:SmallMolecule\". If two edge types differ only in their subject category, but use the same predicate, object_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative subject categories. e.g. if a source provides SmallMolecule-treats-Disease and  MolecularMixture-treats-Disease edge types, these can be described in a single EdgeType object with two subject categories (SmallMolecule and MolecularMixture).",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/subject_categories",
      "alias": "subject_categories",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__predicates",
      "description": "Biolink predicate(s) that defines this type of edge. Multiple values allowed ONLY if they are a predicate and one or more of its descendent predicates (e.g. [\"biolink:affects\", \"biolink:regulates\", \"biolink:disrupts\"]. Otherwise,  separate EdgeType objects should be created for each predicate. ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/predicates",
      "alias": "predicates",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__object_categories",
      "description": "The Biolink category of the object node of this edge type. e.g. \"biolink:Disease\". If two edge types differ only in their object category, but use the same predicate, subject_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative object categories. e.g. if a source provides Gene-associated_with-Disease and  Gene-associated_with-PhenotypicFeature edge types, these can be described in a single EdgeType object with two subject categories (Disease and PhenotypicFeature)",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/object_categories",
      "alias": "object_categories",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__qualifiers",
      "description": "If relevant, report any qualifiers applied to the edge type, as a Qualifier object that contains a  qualifier_property and qualifier_range pair. e.g. the property \"biolink:subject_aspect_qualifier\", and range  \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/qualifiers",
      "alias": "qualifiers",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "Qualifier",
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__knowledge_level",
      "description": "The knowledge level (or levels) relevant to this type of edge. Multivalued only if instances of this type of edge can have different knowledge levels in the data.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/knowledge_level",
      "alias": "knowledge_level",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "KnowledgeLevelEnum",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__agent_type",
      "description": "The agent type (or types) relevant to this type of edge. Multivalued only if instances of this type of edge can have different agent types in the data.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/agent_type",
      "alias": "agent_type",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "AgentTypeEnum",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__primary_knowledge_sources",
      "description": "The infores id(s) of the 'primary knowledge sources' for this type of edge. Note that only one primary knowledge source is allowed per edge, but there may be more than one possible value here across edges for a given type (e.g. see the infores:diseases RIG/data)",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/primary_knowledge_sources",
      "alias": "primary_knowledge_sources",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__supporting_data_sources",
      "description": "The infores id(s) of any 'supporting data sources' for this type of edge.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/supporting_data_sources",
      "alias": "supporting_data_sources",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__aggregator_knowledge_sources",
      "description": "The infores id(s) of any 'aggregator_knowledge sources' for this type of edge. ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/aggregator_knowledge_sources",
      "alias": "aggregator_knowledge_sources",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__edge_properties",
      "description": "A list of one or more Biolink edge properties used in instances of this edge type in the data.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/edge_properties",
      "alias": "edge_properties",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "uriorcurie",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__ui_explanation",
      "description": "An explanation of how the source data for an edge of a particular type was generated (as rationale for why the knowledge level, agent type, and knowledge source choices for this edge type were made), along with an explanation for how/why the source data record for a particular edge was transformed into a its current Biolink edge-based representation. Note that this text will be displayed in the UI to explain the provenance of a specific edge, and should be framed accordingly.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/ui_explanation",
      "alias": "ui_explanation",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__source_files",
      "description": "The source file or files that provided data included in or informing edges of this type. Will usually be a single file. Multivalued because some edges are based on data that come form more than one file. If the data is ingested from a database instance or API endpoint, provide analogous information here (e.g. the name of an specific API endpoint, a database access url, or a set of tables in a database schema). ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/source_files",
      "alias": "source_files",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "edgeType__additional_notes",
      "description": "Additional notes, considerations, or explanations of modeling patterns used for this edge type, that were not otherwise captured in dedicated fields.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/additional_notes",
      "alias": "additional_notes",
      "owner": "EdgeType",
      "domain_of": [
        "EdgeType"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "qualifier__property",
      "description": "The Biolink qualifier slot that defines the kind of Qualifier specified, e.g. \"biolink:subject_aspect_qualifier\", \"qualified_predicate\".",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/property",
      "alias": "property",
      "owner": "Qualifier",
      "domain_of": [
        "Qualifier"
      ],
      "range": "uriorcurie",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "qualifier__value_range",
      "description": "The Biolink class(es) or type(s) that specifies the kind of value the qualifier property takes, Reported as the name of a Biolink class, enumeration, or data type, as appropriate.  e.g. \"biolink:Disease\", \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum\", \"biolink:string\"",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/value_range",
      "alias": "value_range",
      "owner": "Qualifier",
      "domain_of": [
        "Qualifier"
      ],
      "range": "uriorcurie",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "qualifier__value_enumeration",
      "description": "A set of one or more specific values for the qualifier in an Edge type (e.g. [\"biolink:causes\"] as the only value for the \"biolink:qualified_predicate\" qualifier property, [\"activity_or_abundance\", \"activity\", \"abundance\"]  as the values for the \"biolink:object_aspect_qualifier\" property). ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/value_enumeration",
      "alias": "value_enumeration",
      "owner": "Qualifier",
      "domain_of": [
        "Qualifier"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "qualifier__value_id_prefixes",
      "description": "One or more id prefixes from which the qualifier value must come. e.g. \"HP\" if the qualifier must be a Human Phenotype Ontology term. ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/value_id_prefixes",
      "alias": "value_id_prefixes",
      "owner": "Qualifier",
      "domain_of": [
        "Qualifier"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "qualifier__value_description",
      "description": "A free text description of the types of value allowed for the qualifier.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/value_description",
      "alias": "value_description",
      "owner": "Qualifier",
      "domain_of": [
        "Qualifier"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "nodeType__node_category",
      "description": "The high-level Biolink category of nodes as assumed or assigned by ingestors. e.g. \"biolink:Gene\". Note that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/node_category",
      "alias": "node_category",
      "owner": "NodeType",
      "domain_of": [
        "NodeType"
      ],
      "range": "uriorcurie",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "nodeType__source_identifier_types",
      "description": "The type of identifier(s) used for this category of entity by the source system. Report as a prefix for an identifier system where appropriate/possible (preferably a prefix as cataloged in the Biolink prefix map here: https://github.com/biolink/biolink-model/blob/master/project/prefixmap/biolink-model-prefix-map.json). e.g. \"MESH\", \"CTD\", \"ECTO\". If prefix for a public system/database is not in the prefix map, you may make a PR to add it.  If the identifiers used are bespoke, or no identifiers are used, the value can be a free text description. e.g. \"The source uses entity names but does not assign identifiers\".",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/source_identifier_types",
      "alias": "source_identifier_types",
      "owner": "NodeType",
      "domain_of": [
        "NodeType"
      ],
      "range": "string",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "nodeType__node_properties",
      "description": "A list of one or more Biolink node properties used in instances of this node type in the data.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/node_properties",
      "alias": "node_properties",
      "owner": "NodeType",
      "domain_of": [
        "NodeType"
      ],
      "range": "uriorcurie",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "nodeType__additional_notes",
      "description": "Additional notes, considerations, or explanations concerning this node type, that were not otherwise captured in dedicated attributes.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/additional_notes",
      "alias": "additional_notes",
      "owner": "NodeType",
      "domain_of": [
        "NodeType"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "futureModelingConsiderations__category",
      "description": "An optional general category for the modeling consideration (e.g. \"spoq_pattern\", \"edge_properties\")",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/category",
      "alias": "category",
      "owner": "FutureModelingConsiderations",
      "domain_of": [
        "FutureModelingConsiderations"
      ],
      "range": "ModelingCategoryEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "futureModelingConsiderations__consideration",
      "description": "A description of the modeling changes to consider, and why.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/consideration",
      "alias": "consideration",
      "owner": "FutureModelingConsiderations",
      "domain_of": [
        "FutureModelingConsiderations"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "provenanceInformation__contributions",
      "description": "The name of a person making a contribution, and the type of contribution made. e.g. \"code author\", \"code support\", \"data modeling\", \"domain expertise\".",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/contributions",
      "alias": "contributions",
      "owner": "ProvenanceInformation",
      "domain_of": [
        "ProvenanceInformation"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "provenanceInformation__artifacts",
      "description": "Links to and descriptions of external artifacts related to the provenance of the ingest, such as Github issues, surveys of prior ingests of the source, etc.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slot_uri": "https://w3id.org/biolink/vocab/artifacts",
      "alias": "artifacts",
      "owner": "ProvenanceInformation",
      "domain_of": [
        "ProvenanceInformation"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    }
  ],
  "classes": [
    {
      "name": "ReferenceIngestGuide",
      "definition_uri": "https://w3id.org/biolink/vocab/ReferenceIngestGuide",
      "description": "A container that holds attributes for the discrete sections of information comprising a Resource Ingest Guide.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "referenceIngestGuide__name",
        "referenceIngestGuide__supporting_data_source_info",
        "referenceIngestGuide__source_info",
        "referenceIngestGuide__ingest_info",
        "referenceIngestGuide__target_info",
        "referenceIngestGuide__provenance_info"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "name",
          "description": "A human readable name for the RIG.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "supporting_data_source_info",
          "description": "Information about upstream sources of data that are used by an ingested source, to derive the knowledge that we ingest.",
          "comments": [
            "This slot is optional, and can be omitted for typical ingest of an external knowledge source - as it is mainly relevant for describing \"ingest\" of data-derived KPs like ICEES, COHD, various Multiomics KPs, etc."
          ],
          "range": "SupportingDataSourceInformation",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "source_info",
          "description": "Information about the source from which content is ingested.",
          "range": "SourceInformation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ingest_info",
          "description": "Information about the rationale and scope of an ingest, including what source content was included and excluded from the ingest, and what additional content might be considered in future iterations.",
          "range": "IngestInformation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "target_info",
          "description": "Information about the dataset / knowledge graph output by the ingest,  including what types of edges and nodes were produced, modeling rationale,  and what modeling changes might be considered in future iterations.",
          "range": "TargetInformation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "provenance_info",
          "description": "Information about the provenance of the ingest, including who contributed and how, and links to external provenance-related artifacts (e.g. Github tickets, ingest surveys, etc.)",
          "range": "ProvenanceInformation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/ReferenceIngestGuide",
      "@type": "ClassDefinition"
    },
    {
      "name": "SupportingDataSourceInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/SupportingDataSourceInformation",
      "description": "A container for information about upstream sources of data that are used by an ingested source, to derive the knowledge that we ingest. This info is not relevant for typical ingest of an external knowledge source, and applies mainly for describing \"ingest\" of data-derived KPs like ICEES, COHD, various Multiomics KPs, etc.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "supportingDataSourceInformation__infores_id",
        "supportingDataSourceInformation__name",
        "supportingDataSourceInformation__description",
        "supportingDataSourceInformation__terms_of_use_info",
        "supportingDataSourceInformation__relevant_files"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "infores_id",
          "description": "The infores identifier of the source from which content is being ingested, e.g. \"infores:ctd\".",
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "name",
          "description": "A human-readable name for the source of supporting data, e.g. \"Aggregate Analysis of ClinicalTrial.gov (AACT)\"",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "description",
          "description": "A brief description of the source, including its purpose, scope, and any relevant background information.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "terms_of_use_info",
          "description": "Information about conditions for use of the ingested source. May include the name of a community license (e.g. `CC-BY 4.0`), a link to a \"terms of use\" or license information web page (e.g. `https://ctdbase.org/about/legal.jsp`), and/or a free-text summary of key terms of use.",
          "range": "TermsOfUseInformation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "relevant_files",
          "description": "A description of each source file (or API endpoint, database, or table) that contains data used to create the ingested knowledge. Source files that contain data not used to created knowledge need not be listed or described.",
          "range": "RelevantFiles",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/SupportingDataSourceInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "SourceInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/SourceInformation",
      "description": "A container for capturing information about the source of the ingest.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "sourceInformation__infores_id",
        "sourceInformation__name",
        "sourceInformation__description",
        "sourceInformation__citations",
        "sourceInformation__terms_of_use_info",
        "sourceInformation__data_access_locations",
        "sourceInformation__data_provision_mechanisms",
        "sourceInformation__data_formats",
        "sourceInformation__data_versioning_and_releases",
        "sourceInformation__source_status",
        "sourceInformation__additional_notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "infores_id",
          "description": "The infores identifier of the source from which content is being ingested, e.g. \"infores:ctd\".",
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "name",
          "description": "A human readable name for the RIG",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "description",
          "description": "A brief description of the source, including its purpose, scope, and any relevant background information.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "citations",
          "description": "One ore more citations to publications describing the source. May be a identifier (e.g a pmid or doi), a url to the published document, or a free-text citation.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "terms_of_use_info",
          "description": "Information about conditions for use of the ingested source. May include the name of a community license (e.g. `CC-BY 4.0`), a link to a \"terms of use\" or license information web page (e.g. `https://ctdbase.org/about/legal.jsp`), and/or a free-text summary of key terms of use.",
          "range": "TermsOfUseInformation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_access_locations",
          "description": "Where the source data that is being ingested can be accessed. Provide one or more URLs,  along with optional descriptions of what each URL provides.",
          "range": "string",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_provision_mechanisms",
          "description": "How the source distributes their data (file download, API endpoints, database dump).",
          "range": "ProvisionMechanismEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_formats",
          "description": "The format(s) in which the data is serialized for retrieval and use.",
          "range": "DataFormatEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_versioning_and_releases",
          "description": "A description of how releases are versioned and managed by the source (e.g. general approach, frequency, other important considerations). May also include links to web pages describing such information.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "source_status",
          "description": "The maintenance status of the source, indicating whether it is actively maintained and how regularly it is updated.",
          "range": "SourceStatusEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_notes",
          "description": "Additional notes, considerations, or resources relevant to the source, that were not otherwise captured in dedicated attributes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/SourceInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "TermsOfUseInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/TermsOfUseInformation",
      "description": "A structured representation describing terms for re-use of data from an information resource.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "termsOfUseInformation__terms_of_use_url",
        "termsOfUseInformation__terms_of_use_description",
        "termsOfUseInformation__license_name",
        "termsOfUseInformation__license_url"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "terms_of_use_url",
          "description": "The url of a document or web page where a source describes its terms of use, and/or references a community license that it adopts. (e.g. \"https://ctdbase.org/about/legal.jsp\")",
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        },
        {
          "name": "terms_of_use_description",
          "description": "A free text description of the terms of use for a source.  (e.g. \"Source only indicates 'all rights reserved' in their documentation\")",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "license_name",
          "description": "The name of an established license used by the source (e.g. \"CC BY 4.0\")",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "license_url",
          "description": "The url of an established license (e.g. \"https://creativecommons.org/licenses/by/4.0/\")",
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/TermsOfUseInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "IngestInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/IngestInformation",
      "description": "A container for capturing information about the rationale and scope of an ingest, including what source content was included and excluded from the ingest, and what additional content might be considered in future iterations.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "ingestInformation__ingest_categories",
        "ingestInformation__utility",
        "ingestInformation__scope",
        "ingestInformation__relevant_files",
        "ingestInformation__included_content",
        "ingestInformation__filtered_content",
        "ingestInformation__future_considerations",
        "ingestInformation__additional_notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ingest_categories",
          "description": "A term or terms indicating the type of source being ingested, from the perspective of the ingesting system (e.g. primary knowledge provider, supporting data provider, ontology/terminology provider).",
          "range": "IngestCategoryEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "utility",
          "description": "Brief description of why the source was ingested, and the utility of the data it provides for target system use cases.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "scope",
          "description": "A short, high-level narrative describing of the types of knowledge form the source that are included and excluded in this ingest.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "relevant_files",
          "description": "A description of each source file (or API endpoint, database, or table) that contains content in scope for the ingest. Source files containing content which is not retrieved  in this ingest need not be listed or described.",
          "range": "RelevantFiles",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "included_content",
          "description": "A description of what types of records from relevant files/endpoints/tables above are included in this ingest, and optionally a list of fields from these records that are part of the ingest or used to inform it.",
          "range": "IncludedContent",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "filtered_content",
          "description": "A description of what types of records from each relevant file are not included in the ingest, and the rationale for any filtering rules or exclusion criteria. Only list a file if some but not all records it contains are included in the ingest - to document what subset was excluded, and why.",
          "range": "FilteredContent",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "future_considerations",
          "description": "Notes about content additions or changes to consider in future iterations of this ingest. Separately consider content that will be represented as Edges vs Node Properties vs Edge Properties in the target knowledge graph.",
          "range": "FutureContentConsiderations",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_notes",
          "description": "Additional notes, considerations or resources relevant to source content ingest, that were not otherwise captured in dedicated attributes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/IngestInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "RelevantFiles",
      "definition_uri": "https://w3id.org/biolink/vocab/RelevantFiles",
      "description": "A structure for describing each source file (or API endpoint, database, or table) that contains content in scope for the ingest. Source files containing which content is not retrieved  in this ingest need not be listed or described.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "relevantFiles__file_name",
        "relevantFiles__location",
        "relevantFiles__description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "file_name",
          "description": "The name of the relevant file (or endpoint, or table).",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "location",
          "description": "The URL of a web page or ftp site where the indicated file (or endpoint or table) was accessed.",
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "description",
          "description": "An optional brief description of the content and/or utility of the file (or endpoint or table)",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/RelevantFiles",
      "@type": "ClassDefinition"
    },
    {
      "name": "IncludedContent",
      "definition_uri": "https://w3id.org/biolink/vocab/IncludedContent",
      "description": "A structure for describing the types of records from relevant files/endpoints/tables are included in this ingest, and optionally a list of fields from these records that are part of the ingest or used to inform it.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "includedContent__file_name",
        "includedContent__included_records",
        "includedContent__fields_used"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "file_name",
          "description": "The name of the relevant file (or endpoint, or table) from which content is included.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "included_records",
          "description": "A description of the types of records that are included in the ingest.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fields_used",
          "description": "Optional list of the specific source fields that are part of or inform the ingest.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/IncludedContent",
      "@type": "ClassDefinition"
    },
    {
      "name": "FilteredContent",
      "definition_uri": "https://w3id.org/biolink/vocab/FilteredContent",
      "description": "A structure for describing the types of records from each relevant file/endpoint/table not included in the ingest, and the rationale for any filtering rules or exclusion criteria. Only list a file if some but not all records it contains are included in the ingest - to document what subset was excluded, and why.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "filteredContent__file_name",
        "filteredContent__filtered_records",
        "filteredContent__rationale"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "file_name",
          "description": "The name of the relevant file (or endpoint, or table) form which content was filtered.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "filtered_records",
          "description": "A description of what types of records were excluded from the ingest, in terms of filtering rules or exclusion criteria.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rationale",
          "description": "The rationale for excluding the indicated content (why this subset of records was filtered out).",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/FilteredContent",
      "@type": "ClassDefinition"
    },
    {
      "name": "FutureContentConsiderations",
      "definition_uri": "https://w3id.org/biolink/vocab/FutureContentConsiderations",
      "description": "A structure for collecting notes about content additions or changes to consider in future iterations of this ingest. Create separate objects for each distinct consideration, and indicate if it relates to  content that will be captured as Edges, Node Properties, or Edge Properties in the target knowledge graph.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "futureContentConsiderations__category",
        "futureContentConsiderations__consideration",
        "futureContentConsiderations__relevant_files"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "category",
          "description": "The category of content described by a given consideration, based on how the content will be represented in the target graph (e.g. \"Edges\", 'Node Properties\",  \"Edge Properties\").",
          "range": "ContentCategoryEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "consideration",
          "description": "A description of what additional content should be considered and why.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "relevant_files",
          "description": "A list of the relevant source file or files that provide the considered content.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/FutureContentConsiderations",
      "@type": "ClassDefinition"
    },
    {
      "name": "TargetInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/TargetInformation",
      "description": "A structure for capturing information about the target dataset / knowledge graph output by the ingest, including what types of edges and nodes were produced, modeling rationale, and what modeling changes might be considered in future iterations.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "targetInformation__infores_id",
        "targetInformation__edge_type_info",
        "targetInformation__node_type_info",
        "targetInformation__future_considerations",
        "targetInformation__additional_notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "infores_id",
          "description": "An infores identifier assigned to the target resource that will be created from the ingested content. e.g. \"infores:translator-ctd\".",
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        },
        {
          "name": "edge_type_info",
          "description": "A description of each type of edge (metaedge) created in the target knowledge graph by this ingest, including what types of edge properties it holds, and a brief explanation of why this modeling pattern was deemed appropriate to represent the source data (to be displayed for end users in a UI system).",
          "range": "EdgeType",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "node_type_info",
          "description": "A description of each type of node created in the target knowledge graph by this ingest, in terms of the high-level Biolink categories of nodes as assumed or assigned by ingestors.  Note however that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph.",
          "range": "NodeType",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "future_considerations",
          "description": "Notes about mapping/modeling changes to consider in future iterations of this ingest.",
          "range": "FutureModelingConsiderations",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_notes",
          "description": "Additional notes, considerations or resources relevant to mapping or modeling source data to the target model, that were not otherwise captured in dedicated attributes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/TargetInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "EdgeType",
      "definition_uri": "https://w3id.org/biolink/vocab/EdgeType",
      "description": "A structure for describing each type of edge (metaedge) created in the target knowledge graph by this ingest, including what types of edge properties it holds, and a brief explanation of why this modeling pattern was deemed appropriate to represent the source data (for display to end users in a UI system). Note that an edge type with multiple subject_category and object_category values does not mean that the full cross-product must be instantiated in the data. e.g. A KG with the edge type sub_cat: [Gene, Protein, Small Molecule], predicate: affects, obj_cat: [disease, phenotype, symptom] might include  Protein-affects-Disease and Gene-affects-Symptom edges, but not include any  Protein-affects-Symptom edges.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "edgeType__subject_categories",
        "edgeType__predicates",
        "edgeType__object_categories",
        "edgeType__qualifiers",
        "edgeType__knowledge_level",
        "edgeType__agent_type",
        "edgeType__primary_knowledge_sources",
        "edgeType__supporting_data_sources",
        "edgeType__aggregator_knowledge_sources",
        "edgeType__edge_properties",
        "edgeType__ui_explanation",
        "edgeType__source_files",
        "edgeType__additional_notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "subject_categories",
          "description": "The Biolink category of the subject node of this edge type. e.g. \"biolink:SmallMolecule\". If two edge types differ only in their subject category, but use the same predicate, object_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative subject categories. e.g. if a source provides SmallMolecule-treats-Disease and  MolecularMixture-treats-Disease edge types, these can be described in a single EdgeType object with two subject categories (SmallMolecule and MolecularMixture).",
          "range": "uriorcurie",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "predicates",
          "description": "Biolink predicate(s) that defines this type of edge. Multiple values allowed ONLY if they are a predicate and one or more of its descendent predicates (e.g. [\"biolink:affects\", \"biolink:regulates\", \"biolink:disrupts\"]. Otherwise,  separate EdgeType objects should be created for each predicate. ",
          "range": "uriorcurie",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "object_categories",
          "description": "The Biolink category of the object node of this edge type. e.g. \"biolink:Disease\". If two edge types differ only in their object category, but use the same predicate, subject_category,  edge properties, and general provenance, they can be described together in a single NodeType object that captures the alternative object categories. e.g. if a source provides Gene-associated_with-Disease and  Gene-associated_with-PhenotypicFeature edge types, these can be described in a single EdgeType object with two subject categories (Disease and PhenotypicFeature)",
          "range": "uriorcurie",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "qualifiers",
          "description": "If relevant, report any qualifiers applied to the edge type, as a Qualifier object that contains a  qualifier_property and qualifier_range pair. e.g. the property \"biolink:subject_aspect_qualifier\", and range  \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum",
          "range": "Qualifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "knowledge_level",
          "description": "The knowledge level (or levels) relevant to this type of edge. Multivalued only if instances of this type of edge can have different knowledge levels in the data.",
          "range": "KnowledgeLevelEnum",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "agent_type",
          "description": "The agent type (or types) relevant to this type of edge. Multivalued only if instances of this type of edge can have different agent types in the data.",
          "range": "AgentTypeEnum",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "primary_knowledge_sources",
          "description": "The infores id(s) of the 'primary knowledge sources' for this type of edge. Note that only one primary knowledge source is allowed per edge, but there may be more than one possible value here across edges for a given type (e.g. see the infores:diseases RIG/data)",
          "range": "uriorcurie",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "supporting_data_sources",
          "description": "The infores id(s) of any 'supporting data sources' for this type of edge.",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "aggregator_knowledge_sources",
          "description": "The infores id(s) of any 'aggregator_knowledge sources' for this type of edge. ",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "edge_properties",
          "description": "A list of one or more Biolink edge properties used in instances of this edge type in the data.",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ui_explanation",
          "description": "An explanation of how the source data for an edge of a particular type was generated (as rationale for why the knowledge level, agent type, and knowledge source choices for this edge type were made), along with an explanation for how/why the source data record for a particular edge was transformed into a its current Biolink edge-based representation. Note that this text will be displayed in the UI to explain the provenance of a specific edge, and should be framed accordingly.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "source_files",
          "description": "The source file or files that provided data included in or informing edges of this type. Will usually be a single file. Multivalued because some edges are based on data that come form more than one file. If the data is ingested from a database instance or API endpoint, provide analogous information here (e.g. the name of an specific API endpoint, a database access url, or a set of tables in a database schema). ",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_notes",
          "description": "Additional notes, considerations, or explanations of modeling patterns used for this edge type, that were not otherwise captured in dedicated fields.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/EdgeType",
      "@type": "ClassDefinition"
    },
    {
      "name": "Qualifier",
      "definition_uri": "https://w3id.org/biolink/vocab/Qualifier",
      "description": "A qualifier property + value tuple that specifies a type of qualifier and value that may be applied to a Statement. Qualified predicates are considered qualifiers and captured here as well. Values can be specified to come from a proper range (e.g. Biolink class, data type, or enum), come from an enumerated list, use a specific id prefix, and/or conform informally to a free-text description. ",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "qualifier__property",
        "qualifier__value_range",
        "qualifier__value_enumeration",
        "qualifier__value_id_prefixes",
        "qualifier__value_description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "property",
          "description": "The Biolink qualifier slot that defines the kind of Qualifier specified, e.g. \"biolink:subject_aspect_qualifier\", \"qualified_predicate\".",
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value_range",
          "description": "The Biolink class(es) or type(s) that specifies the kind of value the qualifier property takes, Reported as the name of a Biolink class, enumeration, or data type, as appropriate.  e.g. \"biolink:Disease\", \"biolink:GeneOrGeneProductOrChemicalEntityAspectEnum\", \"biolink:string\"",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value_enumeration",
          "description": "A set of one or more specific values for the qualifier in an Edge type (e.g. [\"biolink:causes\"] as the only value for the \"biolink:qualified_predicate\" qualifier property, [\"activity_or_abundance\", \"activity\", \"abundance\"]  as the values for the \"biolink:object_aspect_qualifier\" property). ",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value_id_prefixes",
          "description": "One or more id prefixes from which the qualifier value must come. e.g. \"HP\" if the qualifier must be a Human Phenotype Ontology term. ",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value_description",
          "description": "A free text description of the types of value allowed for the qualifier.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/Qualifier",
      "@type": "ClassDefinition"
    },
    {
      "name": "NodeType",
      "definition_uri": "https://w3id.org/biolink/vocab/NodeType",
      "description": "A structured object describing each type of node created in the target knowledge graph by this ingest.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "nodeType__node_category",
        "nodeType__source_identifier_types",
        "nodeType__node_properties",
        "nodeType__additional_notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "node_category",
          "description": "The high-level Biolink category of nodes as assumed or assigned by ingestors. e.g. \"biolink:Gene\". Note that downstream normalization of node identifiers may result in new/different categories ultimately being assigned in the final graph.",
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "source_identifier_types",
          "description": "The type of identifier(s) used for this category of entity by the source system. Report as a prefix for an identifier system where appropriate/possible (preferably a prefix as cataloged in the Biolink prefix map here: https://github.com/biolink/biolink-model/blob/master/project/prefixmap/biolink-model-prefix-map.json). e.g. \"MESH\", \"CTD\", \"ECTO\". If prefix for a public system/database is not in the prefix map, you may make a PR to add it.  If the identifiers used are bespoke, or no identifiers are used, the value can be a free text description. e.g. \"The source uses entity names but does not assign identifiers\".",
          "range": "string",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "node_properties",
          "description": "A list of one or more Biolink node properties used in instances of this node type in the data.",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_notes",
          "description": "Additional notes, considerations, or explanations concerning this node type, that were not otherwise captured in dedicated attributes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/NodeType",
      "@type": "ClassDefinition"
    },
    {
      "name": "FutureModelingConsiderations",
      "definition_uri": "https://w3id.org/biolink/vocab/FutureModelingConsiderations",
      "description": "A structure for collecting discrete considerations about modeling changes to consider in future iterations of this ingest. Create and categorize separate objects for each distinct consideration.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "futureModelingConsiderations__category",
        "futureModelingConsiderations__consideration"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "category",
          "description": "An optional general category for the modeling consideration (e.g. \"spoq_pattern\", \"edge_properties\")",
          "range": "ModelingCategoryEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "consideration",
          "description": "A description of the modeling changes to consider, and why.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/FutureModelingConsiderations",
      "@type": "ClassDefinition"
    },
    {
      "name": "ProvenanceInformation",
      "definition_uri": "https://w3id.org/biolink/vocab/ProvenanceInformation",
      "description": "A container holding information about the provenance of the ingest, including who contributed and how, and links to external provenance artifacts.",
      "from_schema": "https://w3id.org/biolink/resource-ingest-guide-schema",
      "slots": [
        "provenanceInformation__contributions",
        "provenanceInformation__artifacts"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "contributions",
          "description": "The name of a person making a contribution, and the type of contribution made. e.g. \"code author\", \"code support\", \"data modeling\", \"domain expertise\".",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "artifacts",
          "description": "Links to and descriptions of external artifacts related to the provenance of the ingest, such as Github issues, surveys of prior ingests of the source, etc.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/biolink/vocab/ProvenanceInformation",
      "@type": "ClassDefinition"
    }
  ],
