@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

biolink:ReferenceIngestGuide a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReferenceIngestGuide" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:target_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:provenance_info ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:source_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:IngestInformation ;
            owl:onProperty biolink:ingest_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:SourceInformation ;
            owl:onProperty biolink:source_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:source_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:TargetInformation ;
            owl:onProperty biolink:target_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:supporting_data_source_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:ingest_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:target_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:provenance_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:SupportingDataSourceInformation ;
            owl:onProperty biolink:supporting_data_source_info ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:ingest_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:ProvenanceInformation ;
            owl:onProperty biolink:provenance_info ] ;
    skos:definition "A container that holds attributes for the discrete sections of information comprising a Resource Ingest Guide." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:EdgeType a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "EdgeType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:object_categories ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:aggregator_knowledge_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:Qualifier ;
            owl:onProperty biolink:qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:ui_explanation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:predicates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:ui_explanation ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:primary_knowledge_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:AgentTypeEnum ;
            owl:onProperty biolink:agent_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:source_files ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:ui_explanation ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:KnowledgeLevelEnum ;
            owl:onProperty biolink:knowledge_level ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:knowledge_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:object_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:subject_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:agent_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:source_files ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:subject_categories ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:edge_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:primary_knowledge_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:qualifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:supporting_data_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:edge_properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:supporting_data_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:predicates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:aggregator_knowledge_sources ] ;
    skos:definition "A structure for describing each type of edge (metaedge) created in the target knowledge graph by this ingest, including what types of edge properties it holds, and a brief explanation of why this modeling pattern was deemed appropriate to represent the source data (for display to end users in a UI system). Note that an edge type with multiple subject_category and object_category values does not mean that the full cross-product must be instantiated in the data. e.g. A KG with the edge type sub_cat: [Gene, Protein, Small Molecule], predicate: affects, obj_cat: [disease, phenotype, symptom] might include  Protein-affects-Disease and Gene-affects-Symptom edges, but not include any  Protein-affects-Symptom edges." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:FilteredContent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FilteredContent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:filtered_records ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:filtered_records ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:filtered_records ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:rationale ] ;
    skos:definition "A structure for describing the types of records from each relevant file/endpoint/table not included in the ingest, and the rationale for any filtering rules or exclusion criteria. Only list a file if some but not all records it contains are included in the ingest - to document what subset was excluded, and why." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:FutureContentConsiderations a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FutureContentConsiderations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:category ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:ContentCategoryEnum ;
            owl:onProperty biolink:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:relevant_files ] ;
    skos:definition "A structure for collecting notes about content additions or changes to consider in future iterations of this ingest. Create separate objects for each distinct consideration, and indicate if it relates to  content that will be captured as Edges, Node Properties, or Edge Properties in the target knowledge graph." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:FutureModelingConsiderations a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FutureModelingConsiderations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:category ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:ModelingCategoryEnum ;
            owl:onProperty biolink:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:consideration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:category ] ;
    skos:definition "A structure for collecting discrete considerations about modeling changes to consider in future iterations of this ingest. Create and categorize separate objects for each distinct consideration." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:IncludedContent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "IncludedContent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:included_records ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:fields_used ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:included_records ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:included_records ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:fields_used ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:fields_used ] ;
    skos:definition "A structure for describing the types of records from relevant files/endpoints/tables are included in this ingest, and optionally a list of fields from these records that are part of the ingest or used to inform it." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:IngestInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "IngestInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom biolink:IngestCategoryEnum ;
            owl:onProperty biolink:ingest_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:filtered_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:future_considerations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:RelevantFiles ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:FilteredContent ;
            owl:onProperty biolink:filtered_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:utility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:ingest_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:included_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:IncludedContent ;
            owl:onProperty biolink:included_content ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:utility ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:FutureContentConsiderations ;
            owl:onProperty biolink:future_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:utility ] ;
    skos:definition "A container for capturing information about the rationale and scope of an ingest, including what source content was included and excluded from the ingest, and what additional content might be considered in future iterations." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:NodeType a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "NodeType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:source_identifier_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:source_identifier_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:node_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:node_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:node_properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:node_categories ] ;
    skos:definition "A structured object describing each type of node created in the target knowledge graph by this ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:ProvenanceInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProvenanceInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:artifacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:contributions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:artifacts ] ;
    skos:definition "A container holding information about the provenance of the ingest, including who contributed and how, and links to external provenance artifacts." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:Qualifier a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Qualifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:value_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:property ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:value_id_prefixes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:value_range ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:value_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:value_enumeration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:value_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:property ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:value_id_prefixes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:value_range ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:value_enumeration ] ;
    skos:definition "A qualifier property + value tuple that specifies a type of qualifier and value that may be applied to a Statement. Qualified predicates are considered qualifiers and captured here as well. Values can be specified to come from a proper range (e.g. Biolink class, data type, or enum), come from an enumerated list, use a specific id prefix, and/or conform informally to a free-text description. " ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:SourceInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SourceInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:data_versioning_and_releases ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:data_access_locations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:terms_of_use_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:TermsOfUseInformation ;
            owl:onProperty biolink:terms_of_use_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:citations ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:SourceStatusEnum ;
            owl:onProperty biolink:source_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:source_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:data_versioning_and_releases ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:data_access_locations ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:citations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:terms_of_use_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:data_provision_mechanisms ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:DataFormatEnum ;
            owl:onProperty biolink:data_formats ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:data_versioning_and_releases ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:source_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:ProvisionMechanismEnum ;
            owl:onProperty biolink:data_provision_mechanisms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:data_formats ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:description ] ;
    skos:definition "A container for capturing information about the source of the ingest." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:SupportingDataSourceInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SupportingDataSourceInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:RelevantFiles ;
            owl:onProperty biolink:relevant_files ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:terms_of_use_info ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:TermsOfUseInformation ;
            owl:onProperty biolink:terms_of_use_info ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:terms_of_use_info ] ;
    skos:definition "A container for information about upstream sources of data that are used by an ingested source, to derive the knowledge that we ingest. This info is not relevant for typical ingest of an external knowledge source, and applies mainly for describing \"ingest\" of data-derived KPs like ICEES, COHD, various Multiomics KPs, etc." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

biolink:TargetInformation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TargetInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:node_type_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:future_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:EdgeType ;
            owl:onProperty biolink:edge_type_info ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:NodeType ;
            owl:onProperty biolink:node_type_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom biolink:FutureModelingConsiderations ;
            owl:onProperty biolink:future_considerations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty biolink:additional_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty biolink:infores_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty biolink:edge_type_info ] ;
    skos:definition "A structure for capturing information about the target dataset / knowledge graph output by the ingest, including what types of edges and nodes were produced, modeling rationale, and what modeling changes might be considered in future iterations." ;
    skos:inScheme <https://w3id.org/biolink/resource-ingest-guide-schema> .

